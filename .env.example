# Copy to .env and adjust. Never commit .env.

# ── Trained artefacts (unzipped from Colab's supportgen_models.zip) ──
SUPPORTGEN_MODEL_DIR=models/flan-t5-supportgen
SUPPORTGEN_CLASSIFIER_DIR=models/classifiers
SUPPORTGEN_RESULTS_DIR=results
# Pretrained FLAN-T5 used for the live "base vs fine-tuned" comparison
SUPPORTGEN_BASE_MODEL=google/flan-t5-small
# Zero-shot model for ticket summaries (empty = extractive summary only)
SUPPORTGEN_AUX_MODEL=google/flan-t5-base
# Pretrained sentiment model (empty = disabled). Output is labelled "inferred".
SUPPORTGEN_SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
# Recommended action: "rules" (default, from predicted queue/priority) or "generate" (zero-shot, rules as fallback)
SUPPORTGEN_ACTION_MODE=rules
# cpu (fastest for FLAN-T5-small on an M4), mps, cuda or auto
SUPPORTGEN_DEVICE=cpu
SUPPORTGEN_MAX_TICKET_CHARS=5000

# ── Django ──
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Database (USE_POSTGRES=False falls back to SQLite) ──
USE_POSTGRES=True
POSTGRES_DB=supportgen
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Optional Gemini benchmark (app works without it; also: pip install google-genai) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
