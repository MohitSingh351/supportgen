# Copy to .env and adjust. Never commit .env.

# ── Trained artefacts (unzipped from Colab's supportgen_models.zip) ──
SUPPORTGEN_MODEL_DIR=models/flan-t5-supportgen
SUPPORTGEN_CLASSIFIER_DIR=models/classifiers
SUPPORTGEN_RESULTS_DIR=results
# Pretrained model used for summary / recommended action and the live "base vs fine-tuned" comparison
SUPPORTGEN_BASE_MODEL=google/flan-t5-small
SUPPORTGEN_AUX_MODEL=google/flan-t5-base
SUPPORTGEN_MAX_TICKET_CHARS=5000

# ── Django ──
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (USE_POSTGRES=False falls back to SQLite) ──
USE_POSTGRES=True
POSTGRES_DB=supportgen
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Optional Gemini benchmark (app works without it) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
